{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "fg": "#c0caf5",
    "fgDim": "#a9b1d6",
    "muted": "#565f89",
    "fgLight": "#343b58",
    "mutedLight": "#6172b0",
    "blue": "#7aa2f7",
    "blueDark": "#2e7de9",
    "magenta": "#bb9af7",
    "magentaDark": "#9854f1",
    "cyan": "#7dcfff",
    "cyanDark": "#007197",
    "green": "#9ece6a",
    "greenDark": "#587539",
    "greenBright": "#73daca",
    "yellow": "#e0af68",
    "yellowDark": "#8c6c3e",
    "red": "#f7768e",
    "redDark": "#f52a65",
    "redBright": "#ff7a93",
    "purple": "#9d7cd8"
  },
  "theme": {
    "primary": { "dark": "blue", "light": "blueDark" },
    "secondary": { "dark": "magenta", "light": "magentaDark" },
    "accent": { "dark": "cyan", "light": "cyanDark" },
    "error": { "dark": "red", "light": "redDark" },
    "warning": { "dark": "yellow", "light": "yellowDark" },
    "success": { "dark": "green", "light": "greenDark" },
    "info": { "dark": "cyan", "light": "cyanDark" },
    "text": { "dark": "fg", "light": "fgLight" },
    "textMuted": { "dark": "muted", "light": "mutedLight" },
    "selectedListItemText": { "dark": "#1a1b26", "light": "#ffffff" },
    "background": "none",
    "backgroundPanel": "#1a1b26BF",
    "backgroundElement": "#24283bBF",
    "backgroundMenu": "#24283bBF",
    "border": { "dark": "muted", "light": "mutedLight" },
    "borderActive": { "dark": "blue", "light": "blueDark" },
    "borderSubtle": { "dark": "muted", "light": "mutedLight" },
    "diffAdded": { "dark": "green", "light": "greenDark" },
    "diffRemoved": { "dark": "red", "light": "redDark" },
    "diffContext": { "dark": "muted", "light": "mutedLight" },
    "diffHunkHeader": { "dark": "cyan", "light": "cyanDark" },
    "diffHighlightAdded": { "dark": "greenBright", "light": "greenDark" },
    "diffHighlightRemoved": { "dark": "redBright", "light": "redDark" },
    "diffAddedBg": "#1d2f26BF",
    "diffRemovedBg": "#2f1d24BF",
    "diffContextBg": "#1a1b26BF",
    "diffLineNumber": { "dark": "muted", "light": "mutedLight" },
    "diffAddedLineNumberBg": "#25392dBF",
    "diffRemovedLineNumberBg": "#39252bBF",
    "markdownText": { "dark": "fg", "light": "fgLight" },
    "markdownHeading": { "dark": "blue", "light": "blueDark" },
    "markdownLink": { "dark": "cyan", "light": "cyanDark" },
    "markdownLinkText": { "dark": "magenta", "light": "magentaDark" },
    "markdownCode": { "dark": "green", "light": "greenDark" },
    "markdownBlockQuote": { "dark": "muted", "light": "mutedLight" },
    "markdownEmph": { "dark": "yellow", "light": "yellowDark" },
    "markdownStrong": { "dark": "purple", "light": "magentaDark" },
    "markdownHorizontalRule": { "dark": "muted", "light": "mutedLight" },
    "markdownListItem": { "dark": "blue", "light": "blueDark" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyanDark" },
    "markdownImage": { "dark": "cyan", "light": "cyanDark" },
    "markdownImageText": { "dark": "magenta", "light": "magentaDark" },
    "markdownCodeBlock": { "dark": "fg", "light": "fgLight" },
    "syntaxComment": { "dark": "muted", "light": "mutedLight" },
    "syntaxKeyword": { "dark": "magenta", "light": "magentaDark" },
    "syntaxFunction": { "dark": "blue", "light": "blueDark" },
    "syntaxVariable": { "dark": "fg", "light": "fgLight" },
    "syntaxString": { "dark": "green", "light": "greenDark" },
    "syntaxNumber": { "dark": "yellow", "light": "yellowDark" },
    "syntaxType": { "dark": "cyan", "light": "cyanDark" },
    "syntaxOperator": { "dark": "cyan", "light": "cyanDark" },
    "syntaxPunctuation": { "dark": "fgDim", "light": "fgLight" },
    "thinkingOpacity": 0.6
  }
}
